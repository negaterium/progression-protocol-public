# Replace hostname and certificate paths. Provision/renew certificates separately.
server {
    listen 80;
    server_name system.example.com;
    return 301 https://system.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name system.example.com;
    ssl_certificate /etc/letsencrypt/live/system.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/system.example.com/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:9999;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Next.js streaming responses must not wait for proxy buffering.
        proxy_buffering off;
    }
}
