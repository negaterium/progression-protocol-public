# Local development: copy this file to .env.local and edit the copy.
# PostgreSQL is separately managed; provision an EMPTY database for fresh setup.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=progression_protocol
POSTGRES_USER=sls_app
POSTGRES_PASSWORD=replace_me

# Local HTTP development. Production defaults to Secure cookies when unset.
USE_SECURE_COOKIES=false

# Developer privileges are disabled unless existing user UUIDs are listed.
SLS_DEVELOPER_USER_IDS=

# Authentication override: development only; leave disabled for normal login.
SLS_ENABLE_DEV_AUTH=false
SLS_DEV_USER_ID=

# Enable only behind an exclusively accessible proxy that overwrites X-Real-IP.
SLS_TRUST_PROXY_HEADERS=false

# Do not set NODE_ENV here; Next.js sets it for dev/build/start.
# Do not use NEXT_PUBLIC_* for credentials or authentication settings.
