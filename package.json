{
  "name": "progression-protocol",
  "version": "0.1.0",
  "private": true,
  "author": "Negaterium",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "dev": "node scripts/runtime/next.mjs dev",
    "build": "next build",
    "start": "node scripts/runtime/next.mjs start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "security:audit": "node scripts/security/publication-audit.mjs --history",
    "security:verify": "node scripts/security/verify-boundaries.mjs",
    "db:export": "tsx scripts/database/export.ts",
    "db:create-user": "tsx scripts/database/create-user.ts",
    "db:init": "tsx scripts/database/init.ts",
    "db:migrate": "tsx scripts/database/migrate.ts",
    "db:verify": "tsx scripts/database/verify.ts",
    "config:check": "tsx scripts/setup/check.ts",
    "config:doctor": "tsx scripts/setup/check.ts --database",
    "setup:verify": "node scripts/setup/verify.mjs",
    "deployment:verify": "node scripts/setup/verify.mjs --deployment",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "lint:tools": "eslint scripts/database scripts/setup scripts/deployment scripts/runtime scripts/lib scripts/security scripts/community --max-warnings 0",
    "assets:verify": "node scripts/community/verify-assets.mjs",
    "assets:verify:release": "node scripts/community/verify-assets.mjs --release",
    "skills:verify": "node scripts/community/verify-skills.mjs",
    "package:check": "node scripts/community/verify-package.mjs",
    "package:check:public": "node scripts/community/verify-package.mjs --public",
    "public:export": "node scripts/community/export-public-tree.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "next": "16.4.0",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.17"
  },
  "license": "MIT"
}
