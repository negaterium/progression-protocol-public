# App-only Compose: copy this file to .env and edit the copy.
# PostgreSQL stays on your separately managed host. localhost means the container.
# Compose and Next.js CLI files use different dollar-sign escaping rules.
# For complex credentials prefer literal process injection; see DEPLOYMENT.md.
POSTGRES_HOST=db.example.internal
POSTGRES_PORT=5432
POSTGRES_DATABASE=progression_protocol
POSTGRES_USER=sls_app
POSTGRES_PASSWORD=replace_me

# HTTPS production. false is reserved for HTTP on a trusted private network.
USE_SECURE_COOKIES=true

# Comma-separated existing user UUIDs; empty denies developer access.
SLS_DEVELOPER_USER_IDS=

# Enable only when the app can be reached exclusively through your trusted proxy.
SLS_TRUST_PROXY_HEADERS=false

# Compose fixes NODE_ENV=production, PORT=9999 and SLS_ENABLE_DEV_AUTH=false.
# No PostgreSQL service is provisioned by this file or docker-compose.yml.
